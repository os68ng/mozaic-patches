// A simple arpeggiator
//
// Author: os68ng
// Version: 0.2

@Description
A simple arpeggiator which can be used in any AUv3 host that supports MIDI plugins.

Press SHIFT for setting the MIDI channel and a fixed velocity.
@End

@OnLoad
  debug = NO
  maxnotes = 8
  ShowLayout 2
  SetShortName {Arpeggiator}
  Call @Init
@End

@OnMidiNoteOn
  keyPressed[MIDINote] = YES
  if latch and noteVelocity[MIDINote] > 0
    note = MIDINote
    Call @NoteOff
  elseif numnotes < maxnotes
    notes[numnotes] = MIDINote
    numnotes = numnotes + 1
    noteVelocity[MIDINote] = MIDIVelocity
    if not beatsync and numnotes = 1
      firstnoteoffset = CurrentMetroPulse + 1
    endif
  endif
  Call @CreateOrderedNoteList
  Call @DebugNoteList
@End

@OnMidiNoteOff
  keyPressed[MIDINote] = NO
  if not latch
    note = MIDINote
    Call @NoteOff
  endif
@End

@NoteOff
  if numnotes > 0
    for n = 0 to (numnotes - 1)
      if notes[n] = note
        notes[n] = -1
        numnotes = numnotes - 1
        noteVelocity[note] = 0
        if numnotes = 0
          Call @ResetArp
        endif
        Call @CompressNoteList
        Call @CreateOrderedNoteList
        Call @DebugNoteList
        Exit
      endif
    endfor
  endif
@End

// forwards any events that are not note on or off
@OnMidiInput
  if MIDICommand <> 0x80 AND MIDICommand <> 0x90
    SendMIDIOut (MIDICommand + MIDIChannel),MIDIByte2,MIDIByte3
  endif
@End

// The heart
@OnMetroPulse
  if triplets
    if (CurrentMetroPulse - firstnoteoffset) % (ppqdiv * 2 / 3) <> 0
      Exit
    endif
  elseif (CurrentMetroPulse - firstnoteoffset) % ppqdiv <> 0
    Exit
  endif
  FlashUserLed
  Call @HandleArp
@End

@HandleArp
  if HostTempo > 0
    notelen = (60.0 / HostTempo) / ((Pow 2, (division))) * 1000.0 * gate / 100.0
    if triplets
      notelen = notelen * (2.0 / 3.0)
    endif
    if numnotes > 0
      if mode = 0
        Call @ArpUp
      elseif mode = 1
        Call @ArpDown
      elseif mode = 2
        Call @ArpUpDown
      elseif mode = 3
        Call @ArpOrder
      elseif mode = 4
        Call @ArpRandom
      endif
    endif
  endif
@End

// Arp up handler
@ArpUp
  // handle margins first
  if noteindex > numnotes - 1
    noteindex = 0
    octindex = octindex + 1
    if octindex > octave - 1
      octindex = 0
    endif
  endif

  note = notesOrd[noteindex]

  Call @GetVelocity
  note = note + (octindex * 12)
  if note > 127
    Exit
  endif
  if (Random 0, 100) > probability
    Exit
  endif
  Call @DebugArpNote
  SendMidiNoteOn midich, note, velo
  SendMidiNoteOff midich, note, 0, notelen
  noteindex = noteindex + 1
@End

// Arp down handler
@ArpDown
  // handle margins first
  if noteindex < 0
    noteindex = numnotes - 1
    octindex = octindex - 1
    if octindex < 0
      octindex = octave - 1
    endif
  endif

  note = notesOrd[noteindex]

  Call @GetVelocity
  note = note + (octindex * 12)
  if note < 0 or note > 127
    Exit
  endif
  if (Random 0, 100) > probability
    Exit
  endif
  Call @DebugArpNote
  SendMidiNoteOn midich, note, velo
  SendMidiNoteOff midich, note, 0, notelen
  noteindex = noteindex - 1
@End

// Arp up/down handler
@ArpUpDown
  // handle margins first
  if noteindex > numnotes - 1
    octindex = octindex + step
    if octindex > octave - 1
      octindex = octave - 1
      step = -1
      noteindex = numnotes - 1
    else
      noteindex = 0
    endif
  endif
  if noteindex < 0
    octindex = octindex + step
    if octindex < 0
      octindex = 0
      step = 1
      noteindex = 0
    else
      noteindex = numnotes - 1
    endif
  endif

  note = notesOrd[noteindex]

  Call @GetVelocity
  note = note + (octindex * 12)
  if note < 0 or note > 127
    Exit
  endif
  if (Random 0, 100) > probability
    Exit
  endif
  Call @DebugArpNote
  SendMidiNoteOn midich, note, velo
  SendMidiNoteOff midich, note, 0, notelen
  noteindex = noteindex + step
@End

// Arp by order handler
@ArpOrder
  // handle margins first
  if noteindex > numnotes - 1
    octindex = octindex + 1
    if octindex > octave - 1
      octindex = 0
    endif
    noteindex = 0
  endif

  note = notes[noteindex]

  Call @GetVelocity
  note = note + (octindex * 12)
  if note > 127
    Exit
  endif
  if (Random 0, 100) > probability
    Exit
  endif
  Call @DebugArpNote
  SendMidiNoteOn midich, note, velo
  SendMidiNoteOff midich, note, 0, notelen
  noteindex = noteindex + 1
@End

// Arp random handler
@ArpRandom
  nidx = Random 0, numnotes - 1
  oidx = Random 0, octave - 1
  note = notesOrd[nidx]
  Call @GetVelocity
  note = note + (oidx * 12)
  if note > 127
    Exit
  endif
  if (Random 0, 100) > probability
    Exit
  endif
  Call @DebugArpNote
  SendMidiNoteOn midich, note, velo
  SendMidiNoteOff midich, note, 0, notelen
@End

// handles fixed velocity
@GetVelocity
  if fixedVelo
    velo = fixedveloval
  else
    velo = noteVelocity[note]
  endif
@End

// ensure all notes off, espacially in latch mode
@AllNotesOff
  newnumnotes = numnotes
  if numnotes > 0
    for n = 0 to (numnotes - 1)
      note = notes[n]
      if not keyPressed[note]
        notes[n] = -1
        noteVelocity[note] = 0
        newnumnotes = newnumnotes - 1
      endif
    endfor
    numnotes = newnumnotes
    if noteindex > numnotes
      noteindex = numnotes
    endif
    Call @CompressNoteList
    Call @CreateOrderedNoteList
  endif
  Call @DebugNoteList
@End

// remove empty note entries
@CompressNoteList
  FillArray newnotes, -1, maxnotes
  nn = 0
  for n = 0 to maxnotes - 1
    if notes[n] <> -1
      newnotes[nn] = notes[n]
      nn = nn + 1
    endif
  endfor
  CopyArray newnotes, notes, 8
@End

// create an ordered list of notes
@CreateOrderedNoteList
  FillArray notesOrd, -1, maxnotes
  if numnotes > 0
    for n = 0 to numnotes - 1
      gcount = 0
      for m = 0 to numnotes - 1
        if notes[n] > notes[m]
          gcount = gcount + 1
        endif
      endfor
      notesOrd[gcount] = notes[n]
    endfor
  endif
@End

@OnShiftDown
  Call @UpdateKnobValues
@End

@OnShiftUp
  Call @UpdateKnobValues
@End

@OnPadDown
  pad = LastPad
  if pad >= 0 and pad <= 3
    Call @SetDivision
  elseif pad = 4
    Call @ToggleTriplets
  elseif pad = 7
    Call @ToggleBeatSync
  elseif pad >= 8 and pad <= 12
    Call @SetMode
  elseif pad = 14
    Call @ToggleLatch
  elseif pad = 15
    Call @ToggleFixedVelocity
  elseif debug and pad = 6
    Call @DebugVars
  endif
@End

@OnKnobChange
  knob = LastKnob
  if ShiftPressed
    if knob = 0
      Call @SetMidiCh
    elseif knob = 1
      Call @SetFixedVeloValue
    endif
  else
    if knob = 0
      Call @SetSwing
    elseif knob = 1
      Call @SetGate
    elseif knob = 2
      Call @SetOctave
    elseif knob = 3
      Call @SetProbability
    endif
  endif
@End

@SetDivision
  lastdiv = division
  division = LastPad
  for d = 0 to 3
    if d = division
      LatchPad d, YES
    else
      Latchpad d, NO
    endif
  endfor

  Call @UpdateMetroPPQN
@End

@ToggleTriplets
  triplets = not triplets
  LatchPad 4, triplets
@End

@ToggleBeatSync
  beatsync = not beatsync
  if beatsync
    ppqdiv = 3
  else
    ppqdiv = 3 * 12
  endif
  firstnoteoffset = 0
  LatchPad 7, beatsync
  Call @UpdateMetroPPQN
@End

@SetMode
  lastmode = mode
  mode = LastPad - 8
  for m = 0 to 4
    if m = mode
      LatchPad 8 + m, YES
    else
      Latchpad 8 + m, NO
    endif
  endfor
  Call @ResetArp
@End

@ResetArp
  if mode = 1
    step = -1
    noteindex = numnotes - 1
    octindex = octave - 1
  else
    step = 1
    noteindex = 0
    octindex = 0
  endif
  firstnoteoffset = 0
@End

@ToggleLatch
  latch = not latch
  if not latch
    Call @AllNotesOff
  endif
  LatchPad 14, latch
@End

@ToggleFixedVelocity
  fixedvelo = not fixedvelo
  LatchPad 15, fixedvelo
@End

@SetSwing
  knobval = GetKnobValue 0
  swing = Round (knobval / 127.0 * 100)
  Call @UpdateSwingValue 
@End

@UpdateMetroPPQN
  SetMetroPPQN (Pow 2, division) * ppqdiv
@End

@UpdateSwingValue
  LabelKnob 0, {Swng }, swing, {%}
  SetMetroSwing swing
@End

@SetGate
  knobval = GetKnobValue 1
  gate = Round (knobval / 127.0 * 100)
  Call @UpdateGateValue
@End

@UpdateGateValue
  LabelKnob 1, {Gate }, gate, {%}
@End

@SetOctave
  knobval = GetKnobValue 2
  octave = Round (knobval / 127.0 * 3 + 1)
  Call @UpdateOctaveValue
@End

@UpdateOctaveValue
  LabelKnob 2, {Octave }, octave
@End

@SetProbability
  knobval = GetKnobValue 3
  probability = Round (knobval / 127.0 * 100)
  Call @UpdateProbabilityValue
@End

@UpdateProbabilityValue
  LabelKnob 3, {Prob }, probability, {%}
@End

@SetMidiCh
  knobval = GetKnobValue 0
  midich = Round (knobval / 127.0 * 15.0)
  Call @UpdateMidiChValue
@End

@UpdateMidiChValue
  LabelKnob 0, {MidiCh }, midich+1
@End

@SetFixedVeloValue
  knobval = GetKnobValue 1
  fixedveloval = Round(knobval)
  Call @UpdateFixedVeloValue
@End

@UpdateFixedVeloValue
  LabelKnob 1, {FixVelo }, fixedveloval
@End

@UpdateKnobValues
  if ShiftPressed
    SetKnobValue 0, midich / 15.0 * 127.0
    Call @UpdateMidiChValue
    SetKnobValue 1, fixedveloval
    Call @UpdateFixedVeloValue
    LabelKnob 2, { }
    LabelKnob 3, { }
  else
    SetKnobValue 0, swing / 100.0 * 127.0
    Call @UpdateSwingValue
    SetKnobValue 1, gate / 100.0 * 127.0
    Call @UpdateGateValue
    SetKnobValue 2, (octave - 1) / 3.0 * 127.0
    Call @UpdateOctaveValue
    SetKnobValue 3, probability / 100.0 * 127.0
    Call @UpdateProbabilityValue
  endif
@End

// ====================================

@Init
  // only initialize on first load
  if Unassigned arpinit
    arpinit = YES

    swing = 0
    gate = 50
    octave = 1
    probability = 100
  
    division = 0
    triplets = NO
    beatsync = YES

    mode = 0
    latch = NO
    fixedvelo = NO
  
    midich = 0
    fixedveloval = 100
  endif

  ppqdiv = 3

  Call @InitUI
  Call @InitArp
@End

@InitUI
  divisioncolor = 4
  tripletcolor = 5
  modecolor = 6
  utilitycolor = 2

  LabelPads {Arpeggiator}
  
  LabelPad  0, {1/4}
  ColorPad 0, divisioncolor
  LabelPad  1, {1/8}
  ColorPad 1, divisioncolor
  LabelPad  2, {1/16}
  ColorPad 2, divisioncolor
  LabelPad  3, {1/32}
  ColorPad 3, divisioncolor
  LabelPad  4, {Triplets}
  ColorPad 4, tripletcolor

  if debug
    LabelPad 6, {Debug}
  endif

  LabelPad 7, {BeatSync}
  ColorPad 7, utilitycolor
  
  LabelPad  8, {Up}
  ColorPad 8, modecolor
  LabelPad  9, {Down}
  ColorPad 9, modecolor
  LabelPad 10, {Up/Down}
  ColorPad 10, modecolor
  LabelPad 11, {Order}
  ColorPad 11, modecolor
  LabelPad 12, {Random}
  ColorPad 12, modecolor

  LabelPad 14, {Latch}
  ColorPad 14, utilitycolor
  LabelPad 15, {Fixed      Velocity}
  ColorPad 15, utilitycolor

  LabelKnobs { }
  SetKnobValue 0, swing / 100.0 * 127.0
  Call @UpdateSwingValue
  SetKnobValue 1, gate / 100.0 * 127.0
  Call @UpdateGateValue
  SetKnobValue 2, (octave - 1) / 3.0 * 127.0
  Call @UpdateOctaveValue
  SetKnobValue 3, probability / 100.0 * 127.0
  Call @UpdateProbabilityValue

  LatchPad division, YES
  LatchPad 8 + mode, YES
  LatchPad 7, beatsync
  LatchPad 14, latch
  LatchPad 15, fixedvelo
@End

@InitArp
  octindex = 0
  noteindex = 0
  numnotes = 0
  step = 1
  firstnoteoffset = 0

  FillArray notes, -1, maxnotes
  FillArray notesOrd, -1, maxnotes
  FillArray noteVelocity, 0, 128
  FillArray keyPressed, NO, 128

  Call @UpdateMetroPPQN
@End

@DebugNoteList
  if debug
    Log {NumNotes: }, numnotes, { NoteIndex: }, noteindex, { First note offset: }, firstnoteoffset
    Log {Notes }, notes[0], { }, notes[1], { }, notes[2], { }, notes[3], { }, notes[4], { }, notes[5], { }, notes[6], { }, notes[7]
    Log {OrderedNotes }, notesOrd[0], { }, notesOrd[1], { }, notesOrd[2], { }, notesOrd[3], { }, notesOrd[4], { }, notesOrd[5], { }, notesOrd[6], { }, notesOrd[7]
  endif
@End

@DebugArpNote
  if debug
    Log {Arp Index }, noteindex, { Note }, note, { Velocity }, velo, { Notelen }, notelen
  endif
@End

@DebugVars
  Call @DebugNoteList
  Log {Division: }, division
  Log {Triplets: }, triplets
  Log {BeatSync: }, beatsync
  Log {Mode: }, mode
  Log {Latch: }, latch
  Log {FixedVel: }, fixedvelo

  Log {Octave: }, octave
@End
