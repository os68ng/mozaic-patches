@Description
MIDI Clicktrack allows you to send the metronome clicks to a MIDI device. In this
case you are independant of any host. Interesting when you have a MIDI only setup
without DAW audio out for the metronome. Follows the host beat and measure.
Also gives you a visible feedback.
@End

@OnLoad
  ShowLayout 2
  SetShortName {MIDI Clicktrack}
  LabelPads {Beats}
  LabelKnobs {Configuration}
  Call @Init
@End

@OnNewBar
  FlashPad 0
  SendMIDINoteOn ctchan, ctbarnote, ctbarvel 
  SendMIDINoteOff ctchan, ctbarnote, ctbarvel, ctnotelen
@End

@OnNewBeat
  if HostBeat <> 0
    FlashPad HostBeat
    SendMIDINoteOn ctchan, ctbeatnote, ctbeatvel 
    SendMIDINoteOff ctchan, ctbeatnote, ctbeatvel, ctnotelen
  endif
@End

@OnKnobChange
  knob = LastKnob
  knobval = GetKnobValue knob
  if knob = 0
    ctchan = Round (knobval / 127.0 * 15.0)
    LabelKnob 0, {MidiCh }, ctchan + 1
  elseif knob = 1
    ctbarvel = knobval
    LabelKnob 1, {Velo }, ctbarvel
  elseif knob = 2
    ctbarnote = knobval
    LabelKnob 2, {Bar }, NoteName ctbarnote, YES
  elseif knob = 3
    ctbeatnote = knobval
    LabelKnob 3, {Beat }, NoteName ctbeatnote, YES
  endif
@End

// ========================================

@Init
  if Unassigned modinit
    modinit = YES
    ctchan = 9
    ctbarnote = 60
    ctbarvel = 100
    ctbeatnote = 65
    ctbeatvel = ctbarvel - 20
    ctnotelen = 50 // ms
  endif
  Call @InitUI
@End

@InitUI
  LabelKnob 0, {MidiCh }, ctchan + 1
  SetKnobValue 0, ctchan / 15.0 * 127.0
  LabelKnob 1, {Velo }, ctbarvel
  SetKnobValue 1, ctbarvel
  LabelKnob 2, {Bar }, NoteName ctbarnote, YES
  SetKnobValue 2, ctbarnote
  LabelKnob 3, {Beat }, NoteName ctbeatnote, YES
  SetKnobValue 3, ctbeatnote
@End